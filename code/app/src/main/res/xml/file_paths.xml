<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cache directory for temporary CSV files -->
    <cache-path name="csv_files" path="." />

    <!-- cache directory for temporary images related to the QR code display activity -->
    <cache-path name="images" path="images" />
    <!-- External files directory for CSV files (more reliable on emulators) -->
    <external-files-path name="external_csv_files" path="." />
    <external-files-path name="downloads" path="Download" />
</paths>

