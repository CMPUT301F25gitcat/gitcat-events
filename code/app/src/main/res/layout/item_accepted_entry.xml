<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#F0FFF0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Position Number with confirmed indicator -->
        <TextView
            android:id="@+id/tvPosition"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="#1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_green_dark"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:layout_marginEnd="16dp" />

        <!-- User Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Status Badge at top -->
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ CONFIRMED"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@android:color/holo_green_dark"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="8dp" />

            <!-- Name -->
            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="John Doe"
                android:textColor="@color/text_color_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Email -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="2dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:src="@android:drawable/ic_dialog_email"
                    app:tint="@color/text_color_medium" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="john.doe@example.com"
                    android:textColor="@color/text_color_medium"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Phone -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:src="@android:drawable/stat_sys_phone_call"
                    app:tint="@color/text_color_medium" />

                <TextView
                    android:id="@+id/tvPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+1 (555) 123-4567"
                    android:textColor="@color/text_color_medium"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Draw Round -->
            <TextView
                android:id="@+id/tvDrawRound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Draw Round: 1"
                android:textColor="@color/text_color_medium"
                android:textSize="12sp" />

            <!-- Invited Date -->
            <TextView
                android:id="@+id/tvInvitedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Invited: Dec 15, 2024 at 10:30 AM"
                android:textColor="@color/text_color_medium"
                android:textSize="12sp"
                android:textStyle="italic" />

            <!-- Accepted Date (highlighted) -->
            <TextView
                android:id="@+id/tvAcceptedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Accepted: Dec 16, 2024 at 02:15 PM"
                android:textSize="13sp"
                android:textColor="@android:color/holo_green_dark"
                android:textStyle="bold"
                android:padding="4dp"
                android:background="#2000FF00" />

        </LinearLayout>

        <!-- View on Map button (only visible when this accepted entrant has coordinates) -->
        <ImageButton
            android:id="@+id/btnViewOnMap"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="View on Map"
            android:src="@android:drawable/ic_dialog_map"
            android:tint="@android:color/holo_blue_dark"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>

