<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".QRCodeDisplayActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- this is the header with back button part of the QR code display activity  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back"
                android:tint="?attr/colorPrimary"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Event QR Code"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:gravity="center_vertical"/>
        </LinearLayout>

        <!-- this is the event name part of the QR code display activity  -->
        <TextView
            android:id="@+id/tvEventName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:textColor="?attr/colorOnSurface"/>

        <!-- displays the QR code image part of the QR code display activity  -->
        <ImageView
            android:id="@+id/ivQRCode"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:background="@android:color/white"
            android:padding="16dp"
            android:contentDescription="QR Code"
            android:scaleType="fitCenter"/>

        <!-- displays the QR code URL text part of the QR code display activity  -->
        <TextView
            android:id="@+id/tvQRCodeUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:textColor="@android:color/darker_gray"
            android:maxLines="2"
            android:ellipsize="middle"/>

        <!-- displays the instructions part of the QR code display activity  -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share this QR code to promote your event. Users can scan it to view event details."
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="32dp"
            android:textColor="@android:color/darker_gray"
            android:paddingHorizontal="16dp"/>

        <!-- these are the active buttons for the QR code display activity  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnShareQRCode"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Share QR Code"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"
                style="@style/Widget.Material3.Button.OutlinedButton"/>

            <Button
                android:id="@+id/btnSaveQRCode"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Save QR Code to Gallery"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"
                style="@style/Widget.Material3.Button.OutlinedButton"/>

            <Button
                android:id="@+id/btnViewEvent"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="View Event Details"
                android:textSize="16sp"
                android:textColor="@android:color/white"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>