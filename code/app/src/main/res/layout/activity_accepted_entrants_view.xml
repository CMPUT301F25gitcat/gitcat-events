<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_color"
        android:elevation="4dp"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/button_color" />

        <TextView
            android:id="@+id/tvEventName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Enrolled Entrants"
            android:textColor="@color/text_color_colored"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Count Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/container_color"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:src="@android:drawable/checkbox_on_background"
                app:tint="@color/button_color" />

            <TextView
                android:id="@+id/tvAcceptedListCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Enrolled: 0"
                android:textColor="@color/text_color_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Export CSV Button -->
            <Button
                android:id="@+id/btnExportCsv"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="@color/button_color"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="📄 Export CSV"
                android:textColor="@color/text_color_light"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Capacity Info -->
        <TextView
            android:id="@+id/tvCapacityInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Capacity: 0 / 0"
            android:textColor="@color/text_color_dark"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Divider -->

    <!-- Accepted List RecyclerView -->

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvAcceptedListEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No enrolled entrants yet\n\n📋 Run the raffle to select participants\n✉️ Selected participants must accept their invitations"
        android:textAlignment="center"
        android:textColor="@color/text_color_dark"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAcceptedList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout"
                android:layout_width="match_parent"
                android:layout_height="70dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/acceptedListNotifTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Notification Title*" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout2"
                android:layout_width="match_parent"
                android:layout_height="110dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/acceptedListNotifDescription"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Notification Description" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/AcceptedListSendNotif"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="0dp"
                android:backgroundTint="@android:color/holo_green_dark"
                android:text="Send Notifications To Entrants"
                app:cornerRadius="0dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

