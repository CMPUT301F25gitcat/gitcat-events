<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".CreateEventActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header with Back Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/button_color" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Create New Event"
                android:textColor="@color/text_color_colored"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Fill in the details below to create your event"
            android:textColor="@color/text_color_medium"
            android:textSize="14sp" />

        <!-- Event Poster -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Event Poster"
            android:textColor="@color/text_color_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivEventPoster"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginBottom="12dp"
                android:background="@android:color/darker_gray"
                android:contentDescription="Event Poster Preview"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground" />

            <Button
                android:id="@+id/btnSelectPoster"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Poster Image"
                android:textColor="@color/button_color"
                android:textColorLink="@color/button_color"
                app:strokeColor="@color/button_color" />
        </LinearLayout>

        <!-- Event Name -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Event Name *"
            android:textColorHint="@color/text_color_colored"
            app:boxStrokeColor="@color/button_color"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="3dp"
            app:counterTextColor="@color/text_color_colored"
            app:helperTextTextColor="@color/text_color_colored"
            app:hintTextColor="@color/text_color_colored"
            app:placeholderTextColor="@color/text_color_colored">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEventName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textColor="@color/button_color"
                android:textColorLink="@color/button_color" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Registration Opens -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Registration Opens *"
            android:textColor="@color/text_color_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSelectRegistrationStartDate"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Select Start Date"
                android:textColor="@color/button_color"
                app:strokeColor="@color/button_color" />

            <TextView
                android:id="@+id/tvRegistrationStartDateDisplay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/text_color_medium"
                android:gravity="center"
                android:padding="12dp"
                android:text="Not selected"
                android:textColor="@color/text_color_light"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Final Registration Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Final Registration Date *"
            android:textColor="@color/text_color_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Registration closes on this date. You can then run the raffle manually."
            android:textColor="@color/text_color_medium"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSelectRaffleDate"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Select Registration Deadline"
                android:textColor="@color/button_color"
                app:strokeColor="@color/button_color" />

            <TextView
                android:id="@+id/tvRaffleDateDisplay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/text_color_medium"
                android:gravity="center"
                android:padding="12dp"
                android:text="Not selected"
                android:textColor="@color/text_color_light"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Event Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Event Date *"
            android:textColor="@color/text_color_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSelectEventDate"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Select Event Date"
                android:textColor="@color/button_color"
                app:strokeColor="@color/button_color" />

            <TextView
                android:id="@+id/tvEventDateDisplay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/text_color_medium"
