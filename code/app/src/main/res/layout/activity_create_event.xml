                android:gravity="center"
                android:padding="12dp"
                android:text="Not selected"
                android:textColor="@color/text_color_light"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Geolocation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Require Geolocation?"
                android:textColor="@color/text_color_medium"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchGeoLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/text_color_light"
                app:trackTint="@color/button_color" />
        </LinearLayout>

        <!-- Description -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Description *"
            android:textColorHint="@color/button_color"
            app:boxStrokeColor="@color/button_color"
            app:counterTextColor="@color/button_color"
            app:helperTextTextColor="@color/button_color"
            app:hintTextColor="@color/button_color"
            app:placeholderTextColor="@color/button_color">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEventDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Capacity -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Event Capacity (Final List Size) *"
            android:textColorHint="@color/button_color"
            app:boxStrokeColor="@color/button_color"
            app:counterTextColor="@color/button_color"
            app:helperTextTextColor="@color/button_color"
            app:hintTextColor="@color/button_color"
            app:placeholderTextColor="@color/button_color">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCapacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Max Waitlist Size -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Max Waitlist Size (Optional)"
            android:textColorHint="@color/button_color"
            app:boxStrokeColor="@color/button_color"
            app:counterTextColor="@color/button_color"
            app:helperTextTextColor="@color/button_color"
            app:hintTextColor="@color/button_color"
            app:placeholderTextColor="@color/button_color">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMaxWaitlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Selection Criteria -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Selection Criteria (Optional)"
            android:textColorHint="@color/button_color"
            app:boxStrokeColor="@color/button_color"
            app:counterTextColor="@color/button_color"
            app:helperTextTextColor="@color/button_color"
            app:hintTextColor="@color/button_color"
            app:placeholderTextColor="@color/button_color">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSelectionCriteria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="Describe how participants will be selected (e.g., random lottery, first-come-first-served)"
                android:inputType="textMultiLine"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Required Fields Note -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="16dp"
            android:text="* Required fields"
            android:textColor="@color/text_color_medium"
            android:textSize="12sp" />

        <!-- Create Button -->
        <Button
            android:id="@+id/btnCreateEvent"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="@color/button_color"
            android:text="Create Event"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

    </LinearLayout>
</ScrollView>
