<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/UI_color_2_dark"
    android:orientation="vertical"
    tools:context=".AdminMenuActivity">

    <Button
        android:id="@+id/backToProfileBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="16dp"
        android:text="← Back to Profile"
        android:textAllCaps="false"
        android:textColor="@color/UI_color_2_text_light" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Admin Menu"
        android:textAlignment="center"
        android:textColor="@color/UI_color_2_text_light"
        android:textSize="24sp"
        android:textStyle="bold" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/adminTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/UI_color_1_med"
        app:tabIndicatorColor="@color/UI_color_1_text_light"
        app:tabSelectedTextColor="@color/UI_color_1_text_light"
        app:tabTextColor="@color/UI_color_1_text_dark">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notifications" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profiles" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Images" />
    </com.google.android.material.tabs.TabLayout>

    <TextView
        android:id="@+id/adminLoadingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="Loading..."
        android:textAlignment="center"
        android:textColor="#84000000"
        android:textSize="20sp"
        android:textStyle="bold|italic" />

    <ListView
        android:id="@+id/adminNotifsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/UI_color_1_light"
        android:visibility="visible" />

    <ListView
        android:id="@+id/adminProfilesList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/UI_color_1_light"
        android:visibility="gone">

    </ListView>

    <ListView
        android:id="@+id/adminImagesList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/UI_color_1_light"
        android:padding="10dp"
        android:visibility="gone" />

</LinearLayout>